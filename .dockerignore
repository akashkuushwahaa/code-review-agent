# Never ship secrets into the image
.env
*.env
!.env.example

# Local state — the DB belongs on a mounted volume, not baked into the image
findings.db
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Version control and local tooling
.git
.gitignore
.github
.claude

# Python caches / virtualenvs
__pycache__/
*.py[cod]
.venv/
venv/
env/
ENV/

# Planning docs and eval fixtures aren't part of the runtime image
context/
eval/
EVAL_RESULTS.md
